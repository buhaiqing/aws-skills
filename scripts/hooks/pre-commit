#!/usr/bin/env bash
# Pre-commit hard gate — L3 §12 automation + L4 #4 enforced gate.
#
# Triggers (all blocking):
#   1. aws-*-ops/*/SKILL.md → verify cross_skill_deps/delegate dirs exist + te_gate --strict + links_lint --strict (SR-4)
#   2. scripts/gcl_runner.py → --self-test
#   3. scripts/te_gate.py → --all --strict
#   4. scripts/links_lint.py → --all --strict
#   5. Every commit → complete unit-test suite (fail-closed)
#   6. *.py|*.ts|*.go|*.rs|*.js|*.java → codegraph sync .
#   7. All .py files staged for commit → ruff check "$REPO" (full repo, fail-closed)
#
# REPO_ROOT env var overrides auto-detection (for testability).

set -uo pipefail

# Determine paths
HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCRIPTS_DIR="$(dirname "$HOOK_DIR")"
# REPO_ROOT overrides the validated repo (SKILL.md content + dep dir existence),
# used by tests. The hook's own tooling always lives next to the hook script.
REPO="${REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"

CHANGED=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || echo "")
FAIL=0
FAIL_REASONS=()

check_skill_md() {
    local f="$1"
    local skill_dir
    skill_dir=$(dirname "$f")
    # Extract deps via python helper (handles markdown-link + plain-label forms)
    local deps
    deps=$(python3 "$SCRIPTS_DIR/_frontmatter.py" "$f" 2>/dev/null || true)
    for d in $deps; do
        d=$(echo "$d" | tr -d '"'"'" | tr -d ' ')
        [ -z "$d" ] && continue
        if [ ! -d "$REPO/$d" ] && [ ! -d "$REPO/aws-$d-ops" ]; then
            FAIL_REASONS+=("missing dir: $d (referenced from $f)")
            FAIL=1
        fi
    done
    # Run te_gate strict
    if [ -f "$SCRIPTS_DIR/te_gate.py" ]; then
        if ! python3 "$SCRIPTS_DIR/te_gate.py" "$REPO/$skill_dir" --strict >/dev/null 2>&1; then
            FAIL_REASONS+=("te_gate --strict failed for $f")
            FAIL=1
        fi
    fi

    # SR-4 verification: cross-file anchor links must be valid
    if [ -f "$SCRIPTS_DIR/links_lint.py" ]; then
        if ! python3 "$SCRIPTS_DIR/links_lint.py" "$REPO/$skill_dir" --strict >/dev/null 2>&1; then
            FAIL_REASONS+=("links_lint --strict failed for $f (SR-4 broken anchor)")
            FAIL=1
        fi
    fi
}

# Lint gate: fail-closed ruff on full repo (all .py files, independent of staged files).
# Catches context-breaking lint slips anywhere in the repo, not just in scripts/.
if command -v ruff >/dev/null 2>&1; then
    if ! ruff check "$REPO" >/dev/null 2>&1; then
        FAIL_REASONS+=("ruff check . failed — fix before committing (ruff check --fix .)")
        FAIL=1
    fi
else
    FAIL_REASONS+=("ruff not installed — cannot run lint gate (pip install ruff)")
    FAIL=1
fi

# Unit-test gate: every commit must prove the complete repository test suite
# passes. Do not condition this on changed file types; governance changes can
# affect any runtime path and a green partial suite is insufficient evidence.
if [ -d "$REPO/scripts/tests" ]; then
    if ! pytest -p no:rerunfailures "$REPO/scripts/tests/" -q; then
        FAIL_REASONS+=("pytest -p no:rerunfailures scripts/tests/ -q failed — fix tests before committing")
        FAIL=1
    fi
fi

for f in $CHANGED; do
    case "$f" in
        aws-*-ops/SKILL.md)
            check_skill_md "$f"
            ;;
        scripts/gcl_runner.py)
            if [ -f "$SCRIPTS_DIR/gcl_runner.py" ]; then
                if ! python3 "$SCRIPTS_DIR/gcl_runner.py" --self-test --no-prune >/dev/null 2>&1; then
                    FAIL_REASONS+=("gcl_runner.py --self-test failed")
                    FAIL=1
                fi
            fi
            ;;
        scripts/te_gate.py)
            if [ -f "$SCRIPTS_DIR/te_gate.py" ]; then
                if ! python3 "$SCRIPTS_DIR/te_gate.py" --all --strict >/dev/null 2>&1; then
                    FAIL_REASONS+=("te_gate.py --all --strict failed")
                    FAIL=1
                fi
            fi
            ;;
        scripts/links_lint.py)
            if [ -f "$SCRIPTS_DIR/links_lint.py" ]; then
                if ! python3 "$SCRIPTS_DIR/links_lint.py" --all --strict >/dev/null 2>&1; then
                    FAIL_REASONS+=("links_lint.py --all --strict failed (SR-4)")
                    FAIL=1
                fi
            fi
            ;;
        *.py|*.ts|*.go|*.rs|*.js|*.java)
            # A3: when codegraph is installed, sync must succeed (hard).
            # When missing: skip with stderr warn (CI / machines without binary).
            if command -v codegraph >/dev/null 2>&1; then
                if ! codegraph sync . >/dev/null 2>&1; then
                    FAIL_REASONS+=("codegraph sync . failed — refresh index before commit")
                    FAIL=1
                fi
            else
                printf 'pre-commit warn: codegraph not on PATH; skipping sync\n' >&2
            fi
            ;;
    esac
done

if [ "$FAIL" -ne 0 ]; then
    printf 'pre-commit hard gate FAILED:\n' >&2
    for r in "${FAIL_REASONS[@]}"; do
        printf '  - %s\n' "$r" >&2
    done
    exit 1
fi
exit 0
